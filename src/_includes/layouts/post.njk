---
layout: base.njk
---
<article class="prose post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-date">{{ page.date | readableDate }}</p>
    {% if tags %}<p class="post-tags">{% for t in tags %}{% if t != "posts" %}<span class="tag">{{ t }}</span>{% endif %}{% endfor %}</p>{% endif %}
  </header>
  {{ content | safe }}
</article>
